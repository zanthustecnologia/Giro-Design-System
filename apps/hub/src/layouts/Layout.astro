---
import '@giro-ds/tokens/build/css/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Giro Design System',
  description = 'O design system AI-Driven da Zanthus e da Neos',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="header">
      <div class="header__inner">
        <a href="/" class="header__logo">
          <img src="/giro-logo.svg" alt="Giro Design System" height="28" />
        </a>
        <nav class="header__nav" aria-label="Links principais">
          <a href="/blog" class="header__nav-link">Blog</a>
          <a href="https://github.com/zanthustecnologia/Giro-Design-System" target="_blank" rel="noopener noreferrer" class="header__nav-link">GitHub</a>
          <a href="https://www.figma.com/design/uurFrMGj7AqFDHkm6RBtI7" target="_blank" rel="noopener noreferrer" class="header__nav-link">Figma</a>
          <a href="#" class="header__nav-link header__nav-link--cta">Feedback</a>
        </nav>
      </div>
    </header>

    <slot />

    <script>
      const header = document.querySelector('.header');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 0) {
          header?.classList.add('header--scrolled');
        } else {
          header?.classList.remove('header--scrolled');
        }
      }, { passive: true });
    </script>
  </body>
</html>

<style>
  .header {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: calc(100% - 64px);
    max-width: 1136px;
    z-index: 100;
    background: transparent;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: var(--border-width-1) solid var(--color-neutral-high-dark);
    border-radius: var(--border-radius-8);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    transition: width 0.3s ease, max-width 0.3s ease;
  }

  .header:global(.header--scrolled) {
    width: calc(100% - 48px);
    max-width: 1152px;
  }

  .header__inner {
    padding: 0 var(--spacing-24);
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-24);
  }

  .header__nav-link {
    font-size: var(--font-size-14);
    color: var(--color-neutral-low-dark);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .header__nav-link:hover {
    color: var(--color-neutral-low-default);
  }

  .header__nav-link--cta {
    background: var(--color-brand-primary-default);
    color: var(--color-neutral-high-default);
    padding: var(--spacing-8) var(--spacing-16);
    border-radius: var(--border-radius-pill);
    font-weight: var(--font-weight-medium);
  }

  .header__nav-link--cta:hover {
    color: var(--color-neutral-high-default);
    background: var(--color-brand-primary-dark);
  }

  @media (max-width: 640px) {
    .header__inner {
      padding: 0 var(--spacing-16);
    }
  }
</style>
