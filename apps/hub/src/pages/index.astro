  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="container footer__inner">
      <span class="footer__brand">Giro Design System</span>
      <span class="footer__copy">Â© {new Date().getFullYear()} Zanthus Tecnologia. Todos os direitos reservados.</span>
    </div>
  </footer>

</Layout>

<style>
  /* ===== SECTIONS ===== */
  .section {
    padding: calc(70px + 16px + 16px) 0 var(--spacing-48);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-32);
  }

  .section__title {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-bold);
    color: var(--color-neutral-low-default);
    margin-bottom: var(--spacing-24);
  }

  /* ===== BENTO GRID ===== */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 290px 290px;
    gap: var(--spacing-16);
  }

  .bento-card {
    border-radius: var(--border-radius-16);
    border: var(--border-width-1) solid var(--color-neutral-high-medium);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
  }

  .bento-card:hover {
    box-shadow: 0 8px 40px rgba(59, 69, 242, 0.1);
    border-color: var(--color-brand-primary-light);
  }

  .bento-card--react {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    background: linear-gradient(145deg, #eef1ff 0%, #f5f7ff 30%, var(--color-neutral-high-default) 100%);
    display: grid;
    grid-template-rows: auto 1fr;
    padding: var(--spacing-40);
    gap: var(--spacing-32);
  }

  .bento-card--flutter {
    grid-column: 3 / 4;
    grid-row: 1 / 2;
    background: linear-gradient(145deg, #eeffd8 0%, #f5fff0 50%, var(--color-neutral-high-default) 100%);
  }

  .bento-card--figma {
    grid-column: 3 / 4;
    grid-row: 2 / 3;
    background: linear-gradient(145deg, #f0ecff 0%, #f8f5ff 50%, var(--color-neutral-high-default) 100%);
  }

  .bento-card__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .bento-card__text--bottom {
    padding: var(--spacing-24);
    padding-top: 0;
  }

  .bento-card__eyebrow {
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    color: var(--color-neutral-low-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .bento-card__title {
    font-size: var(--font-size-20);
    font-weight: var(--font-weight-regular);
    color: var(--color-neutral-low-default);
    line-height: 1.3;
  }

  .bento-card__title strong {
    font-weight: var(--font-weight-bold);
  }

  .bento-card__cta {
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-medium);
    color: var(--color-brand-primary-default);
    margin-top: var(--spacing-4);
  }

  .bento-card__visual {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bento-card__visual--icons {
    flex: 1;
    padding: var(--spacing-24);
    padding-bottom: var(--spacing-12);
  }

  .mock-browser {
    width: 100%;
    max-width: 360px;
    background: var(--color-neutral-high-default);
    border-radius: var(--border-radius-8);
    border: var(--border-width-1) solid var(--color-neutral-high-dark);
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.07);
    overflow: hidden;
  }

  .mock-browser__bar {
    background: var(--color-neutral-high-light);
    border-bottom: var(--border-width-1) solid var(--color-neutral-high-medium);
    padding: 10px 14px;
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .mock-browser__bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-neutral-high-dark);
  }

  .mock-browser__canvas {
    padding: var(--spacing-16);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }

  .mock-row {
    display: flex;
    gap: var(--spacing-8);
    align-items: center;
  }

  .mock-btn {
    background: var(--color-brand-primary-default);
    color: var(--color-neutral-high-default);
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: var(--border-radius-pill);
    font-family: var(--font-family-primary);
  }

  .mock-btn--outline {
    background: transparent;
    color: var(--color-brand-primary-default);
    border: 1.5px solid var(--color-brand-primary-default);
  }

  .mock-input {
    height: 34px;
    border: var(--border-width-1) solid var(--color-neutral-high-dark);
    border-radius: var(--border-radius-8);
  }

  .mock-card {
    border: var(--border-width-1) solid var(--color-neutral-high-medium);
    border-radius: var(--border-radius-8);
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: var(--spacing-12);
  }

  .mock-card__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-brand-primary-light);
    flex-shrink: 0;
  }

  .mock-card__lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mock-line {
    height: 9px;
    background: var(--color-neutral-high-medium);
    border-radius: var(--border-radius-4);
  }

  .mock-line--short { width: 55%; }

  .mock-tag {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: var(--border-radius-pill);
    font-family: var(--font-family-primary);
  }

  .mock-tag--blue  { background: var(--color-brand-primary-light);   color: var(--color-brand-primary-default); }
  .mock-tag--green { background: var(--color-brand-secondary-medium); color: var(--color-brand-secondary-dark); }
  .mock-tag--red   { background: #ffc7d8; color: #b4052f; }

  .flutter-widgets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-8);
    height: 100%;
  }

  .flutter-widget { border-radius: 40% 60% 55% 45% / 55% 45% 60% 40%; }
  .flutter-widget--1 { background: linear-gradient(135deg, #54d68a, #0aed9b); }
  .flutter-widget--2 { background: linear-gradient(135deg, #6cf4c3, #0ab16b); border-radius: 60% 40% 45% 55% / 40% 60% 40% 60%; }
  .flutter-widget--3 { background: linear-gradient(135deg, #d3ff9a, #8cd92a); border-radius: 50% 50% 60% 40% / 60% 40% 60% 40%; }
  .flutter-widget--4 { background: linear-gradient(135deg, #cadaff, #3b45f2); border-radius: 45% 55% 40% 60% / 45% 55% 45% 55%; }

  .figma-bubbles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-8);
    height: 100%;
  }

  .figma-bubble { border-radius: 50%; }
  .figma-bubble--tl { background: linear-gradient(135deg, #cadaff, #3b45f2); }
  .figma-bubble--tr { background: linear-gradient(135deg, #d2b4de, #8e44ad); border-radius: 40% 60% 60% 40% / 50% 50% 50% 50%; }
  .figma-bubble--bl { background: linear-gradient(135deg, #ffc7d8, #e81e42); border-radius: 60% 40% 40% 60% / 50% 50% 50% 50%; }
  .figma-bubble--br { background: linear-gradient(135deg, #c1fae6, #0aed9b); }

  .bento-card--flutter,
  .bento-card--figma {
    padding: var(--spacing-24);
    gap: var(--spacing-12);
  }

  /* ===== FOUNDATIONS GRID ===== */
  .foundations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-12);
  }

  /* ===== LINKS GRID ===== */
  .links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-12);
  }

  .link-card {
    background: var(--color-neutral-high-default);
    border: var(--border-width-1) solid var(--color-neutral-high-medium);
    border-radius: var(--border-radius-16);
    padding: var(--spacing-24) var(--spacing-28);
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    color: var(--color-neutral-low-default);
    text-decoration: none;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .link-card:hover {
    border-color: var(--color-brand-primary-light);
    box-shadow: 0 4px 24px rgba(59, 69, 242, 0.08);
  }

  .link-card svg {
    flex-shrink: 0;
    color: var(--color-neutral-low-medium);
  }

  .link-card div {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .link-card strong {
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-bold);
  }

  .link-card span {
    font-size: var(--font-size-12);
    color: var(--color-neutral-low-medium);
  }

  /* ===== FOOTER ===== */
  .footer {
    margin-top: var(--spacing-80);
    border-top: var(--border-width-1) solid var(--color-neutral-high-medium);
    padding: var(--spacing-32) 0;
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer__brand {
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-bold);
    color: var(--color-neutral-low-default);
  }

  .footer__copy {
    font-size: var(--font-size-12);
    color: var(--color-neutral-low-medium);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 960px) {
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 280px 200px 200px;
    }

    .bento-card--react   { grid-column: 1 / 3; grid-row: 1 / 2; }
    .bento-card--flutter { grid-column: 1 / 2; grid-row: 2 / 3; }
    .bento-card--figma   { grid-column: 2 / 3; grid-row: 2 / 3; }

    .foundations-grid,
    .links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 var(--spacing-16);
    }

    .bento {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .bento-card--react,
    .bento-card--flutter,
    .bento-card--figma {
      grid-column: 1;
      grid-row: auto;
      min-height: 280px;
    }

    .foundations-grid,
    .links-grid {
      grid-template-columns: 1fr;
    }

    .footer__inner {
      flex-direction: column;
      gap: var(--spacing-8);
      text-align: center;
    }
  }
</style>
