            <div class="bento-card__visual bento-card__visual--icons">
              <div class="figma-bubbles">
                <div class="figma-bubble figma-bubble--tl"></div>
                <div class="figma-bubble figma-bubble--tr"></div>
                <div class="figma-bubble figma-bubble--bl"></div>
                <div class="figma-bubble figma-bubble--br"></div>
              </div>
            </div>
            <div class="bento-card__text bento-card__text--bottom">
              <p class="bento-card__eyebrow">Design</p>
              <h3 class="bento-card__title">Biblioteca no <strong>Figma</strong></h3>
              <span class="bento-card__cta">Abrir no Figma â†’</span>
            </div>
          </a>

        </div>
      </div>
    </section>

    <!-- ===== FUNDAÃ‡Ã•ES ===== -->
    <section class="section">
      <div class="container">
        <h2 class="section__title">FundaÃ§Ãµes compartilhadas</h2>
        <div class="foundations-grid">

          <FoundationCard
            icon="ðŸŽ¨"
            title="Tokens de design"
            description="Cores, tipografia, espaÃ§amento e bordas â€” a base de toda consistÃªncia visual."
            href="/storybook/?path=/docs/foundation-borders--docs"
            linkLabel="Ver tokens"
          />

          <FoundationCard
            icon="â™¿"
            title="Acessibilidade"
            description="Diretrizes e boas prÃ¡ticas para construir interfaces acessÃ­veis para todos."
            href="/storybook/?path=/docs/comece-aqui--docs"
            linkLabel="Ver guia"
          />

          <FoundationCard
            icon="ðŸ“¦"
            title="Componentes"
            description="CatÃ¡logo completo de componentes com documentaÃ§Ã£o e exemplos interativos."
            href="/storybook/?path=/docs/components-avatar--docs"
            linkLabel="Ver componentes"
          />

        </div>
