{
  "name": "zanthus-design-system-monorepo",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build-storybook": "turbo run build-storybook --filter=storybook-app --config-dir apps/storybook/.storybook",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish --provenance --tag latest",
    "release": "npm run changeset:version && npm run build && npm run changeset:publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@rollup/rollup-win32-x64-msvc": "^4.46.3",
    "@types/css-modules": "^1.0.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "prettier": "^3.6.2",
    "rollup": "^4.46.3",
    "rollup-plugin-dts": "6.2.3",
    "sass": "^1.93.2",
    "turbo": "^2.5.4"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.2.1"
  }
}
