{
  "name": "zanthus-design-system-monorepo",
  "private": true,
  "packageManager": "npm@10.9.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "turbo run storybook --filter=./apps/storybook/.storybook",
    "build-storybook": "turbo run build-storybook --filter=./apps/storybook"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "overrides": {
    "vite": "6.3.5",
    "storybook": "9.0.15",
    "@storybook/*": "9.0.15",
    "@chromatic-com/storybook": "4.0.1"
  }

}