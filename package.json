{
  "name": "giro-design-system-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:storybook": "turbo run dev --filter=storybook-react",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --run",
    "check:tokens": "pnpm --filter @giro-ds/tokens build",
    "check:react": "pnpm --filter @giro-ds/react typecheck && pnpm --filter @giro-ds/react exec vitest run && pnpm --filter @giro-ds/react build",
    "check:storybook": "pnpm build-storybook",
    "check:flutter": "cd packages/flutter && dart analyze && cd ../../apps/widgetbook-flutter && dart analyze && flutter test --no-pub",
    "check": "pnpm check:tokens && pnpm check:react && pnpm check:storybook && pnpm check:flutter",
    "hub": "pnpm --filter hub dev",
    "hub:build": "pnpm --filter hub build",
    "storybook": "pnpm --filter storybook-react storybook",
    "storybook:react": "pnpm --filter storybook-react storybook",
    "widgetbook": "cd apps/widgetbook-flutter && flutter run -d chrome",
    "widgetbook:flutter": "cd apps/widgetbook-flutter && flutter run -d chrome",
    "build-storybook": "turbo run build-storybook --filter=storybook-react",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm --filter @giro-ds/version generate",
    "changeset:publish": "changeset publish --provenance --tag latest",
    "release": "pnpm run changeset:version && pnpm run build && pnpm run changeset:publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^9.17.0",
    "@rollup/rollup-win32-x64-msvc": "^4.46.3",
    "@types/css-modules": "^1.0.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-storybook": "^10.2.0",
    "globals": "^15.14.0",
    "prettier": "^3.6.2",
    "rollup": "^4.46.3",
    "rollup-plugin-dts": "6.2.3",
    "sass": "^1.93.2",
    "turbo": "^2.5.4",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.2.1"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0"
    }
  }
}
