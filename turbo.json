{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["../../dist/**", "build/**", "storybook-static/**", "dist/**"]
    },
    "generate": {
      "dependsOn": ["@giro-ds/react#build"],
      "outputs": ["src/data/components.generated.ts"]
    },
    "@giro-ds/version#generate": {
      "dependsOn": [],
      "outputs": ["src/generated/semver.ts"]
    },
    "dev": { "cache": false, "persistent": true },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "dependsOn": ["^test"], "outputs": ["coverage/**"] },
    "clean": { "cache": false }
  }
}
