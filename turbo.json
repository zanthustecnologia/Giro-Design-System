{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["../../dist/**", "build/**", "storybook-static/**", "dist/**"] },
    "generate": { "outputs": ["src/data/components.generated.ts"] },
    "@giro-ds/mcp#build": {
      "dependsOn": ["@giro-ds/tokens#build"],
      "inputs": ["$TURBO_DEFAULT$", "!src/data/components.generated.ts", "!src/data/tokens.generated.ts", "$TURBO_ROOT$/packages/react/src/**"],
      "outputs": ["dist/**", "src/data/components.generated.ts", "src/data/tokens.generated.ts"]
    },
    "@giro-ds/mcp#generate": {
      "inputs": ["$TURBO_DEFAULT$", "!src/data/components.generated.ts", "$TURBO_ROOT$/packages/react/src/**"],
      "outputs": ["src/data/components.generated.ts"]
    },
    "@giro-ds/version#generate": { "dependsOn": [], "outputs": ["src/generated/semver.ts"] },
    "dev": { "cache": false, "persistent": true },
    "storybook": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "dependsOn": ["^test"], "outputs": ["coverage/**"] },
    "clean": { "cache": false }
  }
}
