{
  "name": "@zanthus/components-react",
  "version": "1.0.0",
  "description": "Biblioteca de componentes React para o Zanthus Design System",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:components",
    "build:components": "rollup -c ../../rollup.config.js --bundleConfigAsCjs",
    "dev": "rollup -c ../../rollup.config.js --bundleConfigAsCjs --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@zanthus/tokens": "workspace:*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@storybook/react": "^7.6.3",
    "@storybook/react-vite": "^7.6.3",
    "@storybook/addon-essentials": "^7.6.3",
    "@storybook/addon-docs": "^7.6.3",
    "@storybook/addon-controls": "^7.6.3",
    "@storybook/addon-actions": "^7.6.3",
    "storybook": "^7.6.3",
    "vite": "^5.0.0",
    "rollup": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^0.32.0",
    "eslint": "^8.0.0",
    "rimraf": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}