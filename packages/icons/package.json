{
  "name": "@zanthus/icons",
  "version": "1.0.0",
  "description": "Biblioteca de ícones para o Zanthus Design System",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:icons",
    "build:icons": "rollup -c ../../rollup.config.js",
    "dev": "rollup -c ../../rollup.config.js --watch",
    "test": "echo 'No tests for icons'",
    "test:watch": "echo 'No tests for icons'",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "rollup": "^3.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "rimraf": "^5.0.0"
  }
}
