{
  "name": "@giro-ds/react",
  "version": "3.0.6",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "description": "Biblioteca de componentes React do Zanthus DS",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build": "pnpm run clean && rollup -c rollup.config.cjs --bundleConfigAsCjs",
    "dev": "rollup -c rollup.config.cjs --bundleConfigAsCjs -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "date-fns": "^4.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-content-loader": "^7.1.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.21.2",
    "rollup-plugin-dts": "6.2.3",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.80.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.307",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "clsx": "^2.1.1",
    "i18next": "^25.3.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-i18next": "^15.6.1",
    "react-router-dom": "^7.8.1"
  }
}