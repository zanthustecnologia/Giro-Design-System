{
  "source": ["src/**/*.json"],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "build/",
      "files": [{
        "destination": "css/tokens.css",
        "format": "css/variables"
      }]
    },
    "js": {
      "transformGroup": "js",
      "buildPath": "build/",
      "files": [{
        "destination": "js/tokens.js",
        "format": "javascript/es6"
      }]
    },
    "scss": {
      "transformGroup": "scss",
      "buildPath": "build/",
      "files": [{
        "destination": "scss/tokens.scss",
        "format": "scss/variables"
      }]
    }
  }
}
