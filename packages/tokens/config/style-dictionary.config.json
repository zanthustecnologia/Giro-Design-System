{
    "source": ["packages/tokens/src/**/*.json"],
    "platforms": {
        "css": {
        "transformGroup": "css",
        "buildPath": "packages/tokens/build/",
        "files": [{
            "destination": "css/tokens.css",
            "format": "css/variables"
        }]
        },
        "js": {
        "transformGroup": "js",
        "buildPath": "packages/tokens/build/",
        "files": [{
            "destination": "js/tokens.js",
            "format": "javascript/es6"
        }]
        }
    }
}
