{
  "name": "@giro-ds/tokens",
  "version": "1.0.1",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/types/tokens.d.ts"
    },
    "./build/css/tokens.css": "./build/css/tokens.css",
    "./build/css/*": "./build/css/*",
    "./build/scss/*": "./build/scss/*",
    "./build/js/*": "./build/js/*"
  },
  "types": "./build/types/tokens.d.ts",
  "scripts": {
    "build": "style-dictionary build --config ./config/style-dictionary.config.js && node -e \"require('fs').cpSync('build/dart/tokens.dart', '../flutter/lib/tokens/generated_tokens.dart')\""
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0"
  }
}
