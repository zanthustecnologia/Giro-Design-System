{
  "name": "@giro-ds/utilities",
  "version": "1.0.1",
  "main": "dist/index.css",
  "style": "dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./index.min.css": "./dist/index.min.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "sass src/index.scss dist/index.css --no-source-map",
    "build:min": "sass src/index.scss dist/index.min.css --style=compressed --no-source-map",
    "build:all": "npm run build && npm run build:min"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}